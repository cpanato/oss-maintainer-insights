{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cpanato.github.io/oss-maintainer-insights/schemas/repository-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy",
    "result",
    "selection",
    "requests",
    "rate",
    "failures",
    "complete"
  ],
  "properties": {
    "policy": {
      "enum": [
        "newest-eight-human-prs-90-days-v1",
        "three-age-bands-eighteen-human-prs-90-days-v1"
      ]
    },
    "result": {
      "allOf": [
        {
          "$ref": "analysis-result.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "live_sample"
            }
          }
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listed",
        "selected",
        "eligible_on_page",
        "truncated",
        "list_has_more"
      ],
      "properties": {
        "listed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90
        },
        "selected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "eligible_on_page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90
        },
        "truncated": {
          "type": "boolean"
        },
        "list_has_more": {
          "type": "boolean"
        }
      }
    },
    "requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 90
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remaining", "limit", "resetAt"],
      "properties": {
        "remaining": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "limit": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "resetAt": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pr", "stream", "reason"],
        "properties": {
          "pr": {
            "type": "integer",
            "minimum": 1
          },
          "stream": {
            "enum": ["reviews", "issue_comments", "review_comments"]
          },
          "reason": {
            "enum": [
              "invalid_input",
              "budget",
              "rate_limit",
              "forbidden",
              "not_found",
              "timeout",
              "cancelled",
              "network",
              "http",
              "invalid_response",
              "redirect"
            ]
          }
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "sample_age": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oldest_created_at", "newest_created_at"],
      "properties": {
        "oldest_created_at": {
          "type": "string",
          "format": "date-time"
        },
        "newest_created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policy": {
            "const": "newest-eight-human-prs-90-days-v1"
          }
        }
      },
      "then": {
        "properties": {
          "requests": {
            "maximum": 30,
            "type": "integer"
          },
          "selection": {
            "properties": {
              "selected": {
                "maximum": 8,
                "type": "integer"
              },
              "listed": {
                "maximum": 30,
                "type": "integer"
              },
              "eligible_on_page": {
                "maximum": 30,
                "type": "integer"
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy": {
            "const": "three-age-bands-eighteen-human-prs-90-days-v1"
          },
          "selection": {
            "properties": {
              "selected": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "type": "object"
          }
        }
      },
      "then": {
        "required": ["sample_age"],
        "properties": {
          "sample_age": {
            "$ref": "#/properties/sample_age"
          }
        }
      }
    }
  ]
}
