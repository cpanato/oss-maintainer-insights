{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cpanato.github.io/oss-maintainer-insights/schemas/build-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_revision", "data_revision"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "data_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
