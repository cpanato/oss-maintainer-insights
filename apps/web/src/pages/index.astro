---
import "../styles/global.css";
import InfoTip from "../components/InfoTip.astro";
const base = import.meta.env.BASE_URL;
import catalog from "../../../../catalog/repositories.json";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { parsePublicSnapshot, CATALOG_POLICY } from "../lib/live";
const projects = catalog.map((entry) => {
  let snapshot = null;
  try {
    snapshot = parsePublicSnapshot(
      JSON.parse(
        readFileSync(
          resolve("public/data", `${entry.repository.replace("/", "--")}.json`),
          "utf8",
        ),
      ),
      entry.repository,
    );
  } catch {
    // New catalog entries can await their first successful collection.
  }
  const [owner, name] = entry.repository.split("/");
  return { ...entry, owner, name, snapshot };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Explore who participates in pull request reviews, response times, and coverage in public GitHub repositories."
    />
    <title>OSS Maintainer Insights · Review participation, made visible</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="topbar wrap">
      <a class="brand" href={base}>
        <span class="brand-icon" aria-hidden="true">
          ◈
        </span>
        <span>
          OSS Maintainer <strong>Insights</strong>
        </span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#saved-projects">Projects</a>
        <a href={`${base}methodology/`}>Methodology</a>
        <a href="https://github.com/cpanato/oss-maintainer-insights">
          GitHub ↗
        </a>
      </nav>
    </header>
    <main id="main" class="wrap">
      <section class="intro">
        <p class="eyebrow">
          <span class="dot"></span> OPEN SOURCE, IN FOCUS
        </p>
        <h1>
          The work behind
          <br />
          <em>the pull request.</em>
        </h1>
        <p class="lead">
          Explore review participation and first human responses in a public
          GitHub repository. Every number comes with its sample and coverage.
        </p>
        <section
          id="saved-projects"
          class="saved-projects"
          aria-labelledby="saved-projects-heading"
        >
          <div class="saved-projects-heading">
            <h2 id="saved-projects-heading">Explore the saved catalog</h2>
            <span class="project-count">{projects.length} projects</span>
          </div>
          <p class="saved-projects-description">
            Start with a project below. Saved results load without GitHub API
            calls; the collector covers eligible PRs created in a 90-day window.
          </p>
          <ul class="project-grid">
            {projects.map((project) => (
              <li>
                <a
                  class="project-card"
                  data-repo={project.repository}
                  href={`${base}?repo=${encodeURIComponent(project.repository)}`}
                  aria-label={`Explore saved data for ${project.repository}`}
                >
                  <span class="project-group">{project.group}</span>
                  <span class="project-name">
                    <span class="project-owner">{project.owner}/</span>
                    <strong>{project.name}</strong>
                  </span>
                  <span class="project-summary">
                    {project.snapshot
                      ? `${project.snapshot.selection.selected.toLocaleString("en-US")} PRs · ${project.snapshot.policy === CATALOG_POLICY ? "90-day window" : "Saved sample"}`
                      : "Collection pending"}
                  </span>
                  <span class="project-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
        <form id="query" class="query-form">
          <h2 class="query-heading">Explore another repository</h2>
          <p class="query-description">
            Live queries collect a small recent sample. Add a project to the
            catalog for a complete 90-day collection.
          </p>
          <label for="repository">GitHub repository</label>
          <div class="query-controls">
            <span class="input-mark" aria-hidden="true">
              ⌕
            </span>
            <input
              id="repository"
              name="repository"
              placeholder="owner/repository or GitHub URL"
              autocomplete="off"
              spellcheck="false"
              required
            />
            <button id="inspect" type="submit">
              Explore repository <span aria-hidden="true">→</span>
            </button>
          </div>
          <div class="query-hint">
            <span>
              No sign-in required · 90-day window · Saved data: all eligible PRs
              · Live queries: up to 8 PRs
            </span>
            <button id="cancel" type="button" hidden>
              Cancel query
            </button>
          </div>
        </form>
      </section>
      <section class="status-panel" aria-label="Collection status">
        <p id="status" role="status" aria-live="polite">
          Ready to explore. Queries run directly in your browser.
        </p>
        <p id="collection-progress" class="muted" hidden></p>
        <p id="error" role="alert" hidden></p>
      </section>
      <aside id="contribution" class="catalog-note" hidden>
        <div>
          <p class="eyebrow">ADD A PROJECT</p>
          <h3>Want more data for this repository?</h3>
          <p>
            This repository is not in the saved catalog. You can propose it with
            a pull request to add this repository to the saved catalog. The Go
            collector will enumerate all eligible PRs in a 90-day window; saved
            results become available when collection completes.
          </p>
        </div>
        <a href={`${base}contributing/`}>Read the contribution guide ↗</a>
      </aside>
      <section id="results" hidden aria-label="Repository analysis">
        <div class="result-heading">
          <div>
            <p id="population-label" class="eyebrow">
              RECENT SAMPLE
            </p>
            <h2 id="repo-name"></h2>
            <p id="sample-description" class="muted"></p>
          </div>
          <div class="result-actions">
            <button id="refresh" type="button" class="secondary">
              Refresh live
            </button>
            <button id="clear-cache" type="button" class="quiet">
              Clear cache
            </button>
          </div>
        </div>
        <p id="sample-scope" class="muted"></p>
        <p id="freshness" class="freshness"></p>
        <p id="event-freshness" class="muted" hidden></p>
        <div class="metrics">
          <article class="metric">
            <p>
              PR authors{" "}
              <InfoTip
                id="metric-help-0"
                label="PR authors"
                explanation="Distinct human authors of the selected eligible PRs. Bots and draft PRs are excluded."
              />
            </p>
            <strong id="authors">—</strong>
            <span id="author-note"></span>
          </article>
          <article class="metric">
            <p>
              Review participants{" "}
              <InfoTip
                id="metric-help-1"
                label="Review participants"
                explanation="Distinct human reviewers in PRs with complete review and comment streams. Includes GitHub reviews and active Prow commands; excludes self-reviews and bots."
              />
            </p>
            <strong id="reviewers">—</strong>
            <span id="reviewer-note"></span>
          </article>
          <article class="metric">
            <p>
              Review concentration 80{" "}
              <InfoTip
                id="metric-help-2"
                label="Review concentration 80"
                explanation="The smallest number of reviewers accounting for at least 80% of covered review units. Requires at least five fully covered PRs and one qualifying review unit."
              />
            </p>
            <strong id="concentration">—</strong>
            <span id="concentration-note"></span>
          </article>
          <article class="metric">
            <p>
              First human response{" "}
              <InfoTip
                id="metric-help-3"
                label="First human response"
                explanation="Median wait from PR creation to its first human comment or qualifying review by someone other than its author. Requires at least five responded PRs."
              />
            </p>
            <strong id="response">—</strong>
            <span id="response-note"></span>
          </article>
        </div>
        <div class="analysis-grid">
          <section class="panel review-panel">
            <div class="panel-heading">
              <div>
                <p class="eyebrow">REVIEW ACTIVITY</p>
                <h3>Who takes part in reviews?</h3>
              </div>
              <span id="review-units" class="tag"></span>
            </div>
            <p class="muted">
              One unit per reviewer–PR pair. Repeated reviews on the same PR and
              Prow commands count once.
            </p>
            <p id="review-sources" class="muted"></p>
            <div id="review-controls" class="review-controls" hidden>
              <label for="review-page-size">Participants per page</label>
              <select
                id="review-page-size"
                aria-controls="distribution review-table"
              >
                {[10, 20, 50, 100, 200].map((size) => (
                  <option value={size}>{size}</option>
                ))}
              </select>
            </div>
            <div
              id="distribution"
              class="distribution"
              aria-hidden="true"
            ></div>
            <div
              class="table-scroll"
              tabindex="0"
              aria-label="Review participation table"
            >
              <table>
                <caption>Review participation data</caption>
                <thead>
                  <tr>
                    <th scope="col">
                      Reviewer{" "}
                      <InfoTip
                        id="metric-help-4"
                        label="Reviewer"
                        explanation="The GitHub account that submitted a qualifying review or active Prow command on a selected PR."
                      />
                    </th>
                    <th scope="col">
                      Review units{" "}
                      <InfoTip
                        id="metric-help-5"
                        label="Review units"
                        explanation="One unit per unique reviewer–PR pair. Multiple reviews and Prow commands from the same person on the same PR count once."
                      />
                    </th>
                    <th scope="col">
                      Sources{" "}
                      <InfoTip
                        id="metric-help-6"
                        label="Sources"
                        explanation="Counts reviewer–PR pairs from GitHub reviews and active Prow commands. A pair may appear in both sources, but counts once in total review units."
                      />
                    </th>
                    <th scope="col">
                      Share of covered review units{" "}
                      <InfoTip
                        id="metric-help-7"
                        label="Share"
                        explanation="This reviewer’s review units divided by all review units across the covered PRs, multiplied by 100. For example, 2 of 8 units = 25%. This is not their share of all repository activity."
                      />
                    </th>
                  </tr>
                </thead>
                <tbody id="review-table"></tbody>
              </table>
            </div>
            <nav
              id="review-pagination"
              class="review-pagination"
              aria-label="Review participation pagination"
              hidden
            >
              <p
                id="review-page-summary"
                aria-live="polite"
                aria-atomic="true"
              ></p>
              <div class="review-page-buttons">
                <button
                  id="review-previous"
                  type="button"
                  class="secondary"
                  aria-controls="distribution review-table"
                >
                  Previous
                </button>
                <button
                  id="review-next"
                  type="button"
                  class="secondary"
                  aria-controls="distribution review-table"
                >
                  Next
                </button>
              </div>
            </nav>
            <p id="distribution-empty" hidden>
              No qualifying reviews across the covered PRs.
            </p>
          </section>
          <section class="panel coverage-panel">
            <p class="eyebrow">READ THE DENOMINATORS</p>
            <h3>Coverage &amp; context</h3>
            <dl id="coverage"></dl>
            <p id="coverage-notes" class="muted"></p>
            <details>
              <summary>Collection details</summary>
              <ul id="failure-list"></ul>
            </details>
          </section>
        </div>
        <section class="outcomes">
          <p class="eyebrow">AT OBSERVATION TIME</p>
          <h3>Sample PR outcomes</h3>
          <div id="outcomes"></div>
          <p class="muted">
            These are outcomes for the selected PRs, not repository-wide totals.
          </p>
        </section>
      </section>
      <section
        id="monthly-history"
        class="panel"
        hidden
        aria-labelledby="history-title"
      >
        <p class="eyebrow">SAVED HISTORICAL ACTIVITY</p>
        <h2 id="history-title">Monthly trends</h2>
        <p id="history-status" aria-live="polite"></p>
        <div id="history-data" hidden>
          <p id="history-scope" class="muted"></p>
          <h3>Review units by month</h3>
          <ol
            id="history-bars"
            class="history-bars"
            aria-label="Monthly review units"
          ></ol>
          <div class="table-scroll">
            <table>
              <caption>
                Monthly review activity and PR creation cohorts (UTC)
              </caption>
              <thead>
                <tr>
                  <th scope="col">Window</th>
                  <th scope="col">PRs created</th>
                  <th scope="col">Review units</th>
                  <th scope="col">Review participants</th>
                  <th scope="col">First response median</th>
                  <th scope="col">Responded / covered PRs</th>
                </tr>
              </thead>
              <tbody id="history-rows"></tbody>
            </table>
          </div>
          <p class="muted">
            Review activity includes eligible PRs created before the window.
            Each reviewer–PR pair belongs to its earliest currently qualifying
            review month, including Prow commands. PR counts and response times
            use PRs created within each month. First-response medians require at
            least five responses. Partial months cover only the dates shown;
            outcomes and review states reflect the latest observation.
          </p>
        </div>
      </section>
      <section
        id="empty-state"
        class="overview-grid"
        aria-label="What you can explore"
      >
        <article>
          <span class="feature-number">01 / PARTICIPATION</span>
          <h3>Look at the distribution.</h3>
          <p>
            See who submits reviews and how review participation is concentrated
            across the sample.
          </p>
        </article>
        <article>
          <span class="feature-number">02 / RESPONSE</span>
          <h3>Make waiting visible.</h3>
          <p>
            See first human response times alongside answered, unanswered, and
            fully covered PR counts.
          </p>
        </article>
        <article>
          <span class="feature-number">03 / COVERAGE</span>
          <h3>Know what is missing.</h3>
          <p>
            Limited data stays clearly labeled. An incomplete collection never
            becomes an empty success.
          </p>
        </article>
      </section>

      <section class="catalog-note">
        <div>
          <span class="tag">SAVED HISTORY</span>
          <h3>A longer view of review activity.</h3>
          <p>
            Catalog projects receive a resumable historical backfill. Monthly
            trends appear after all required PR and event pages are collected.
          </p>
        </div>
        <a href={`${base}methodology/`}>
          Read the methodology <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>
    <footer class="wrap">
      <p>Observed activity. Transparent coverage.</p>
      <p>No health scores · No maintainer roster inferred</p>
    </footer>
    <script>
      import "../lib/app.ts";
    </script>
  </body>
</html>
